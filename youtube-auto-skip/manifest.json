{
  "manifest_version": 3,
  "name": "YouTube Auto Skip Ads",
  "version": "1.1.0",
  "description": "Salta automáticamente los anuncios de vídeo de YouTube y oculta los anuncios de banner.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "css": [
        "hide-ads.css"
      ]
    }
  ],
  "action": {
    "default_title": "YouTube Auto Skip Ads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
